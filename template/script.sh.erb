#!/bin/bash

# Load required modules (adjust for your cluster)
module purge
module load uv # If needed

# Create marimo notebook directory if it doesn't exist
mkdir -p "<%= marimo_startup_dir %>"

# Launch marimo
uvx --python $(which python3) marimo edit \
  --proxy <%= ENV['OOD_PORTAL_HOST'] %>:443 \
  --no-token \
  --headless \
  --host 0.0.0.0 \
  --port ${port} \
  --base-url /node/$(hostname)/${port} \
  "<%= marimo_startup_dir %>"
