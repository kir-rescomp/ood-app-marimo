#!/usr/bin/env bash

echo "Starting marimo server..."

# Clean the environment
module purge

# marimo setup requires python >= 3.8. If system python can provide this, remove the 
# corresponding module load
module load Python/3.11.3-GCCcore-12.3.0 uv

# Load any required modules (adjust for your cluster)
# module load python/3.11

# Change to marimo directory
cd "${MARIMO_DIR}"

# Launch marimo server
set -x
uvx --python $(which python3) marimo edit \
  --proxy <%= ENV['OOD_PORTAL_HOST'] %>:443 \
  --no-token \
  --headless \
  --host 0.0.0.0 \
  --port ${port} \
  --base-url /node/${host}/${port} 
